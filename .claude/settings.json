{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tsc-check.cjs",
            "timeout": 60,
            "statusMessage": "Type-checking with tsc..."
          }
        ]
      }
    ]
  }
}
